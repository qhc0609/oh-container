#!/bin/sh
# ============================================================
#  设备上的 claude 入口
#  安装位置: /data/python/lib/python3.8/script/bin/claude
#  （该目录在 OpenHarmony 默认 PATH 中，且在 /data 下可写）
#
#  效果: hdc shell 进去后，在任意目录（包括 /）敲 claude 即可
#        启动容器内的 claude，后端走 DeepSeek。
# ============================================================

# 不打印 "[ohc] 进入容器 ..." 这类日志，让 claude 的输出干净
export OHC_QUIET=1

# 把宿主机窗口尺寸同步到当前 pty（hdc 给的默认是 80x24，写死的）
[ -x /data/ohc/bin/ohc-tty ] && /data/ohc/bin/ohc-tty

# -p / --print 是一次性输出，不需要 tmux，也别留会话
case " $* " in
    *" -p "*|*" --print "*)
        exec /data/ohc/bin/ohc-claude "$@" < /dev/null ;;
esac

# 交互式：默认直接跑，不进 tmux。
#
# 翻屏这件事的最终结论（走了三次弯路）：
#   1. 宿主控制台缓冲区调大 -> 没用，而且窗口一放大就闪退
#   2. 装 tmux，历史归 tmux 管 -> 还是空的
#   3. 真凶：claude 2.x 默认用 fullscreen renderer，自己维护虚拟滚动视口，
#      120 行只把最后十几行画到屏幕上，一行都不交给终端。
#      tmux 的 history 实测就是 0，装什么都是白装。
#
# 解法是在 env 里加 CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1，强制 classic
# renderer：顺序追加输出，行会真正流进 pty -> hdc -> PowerShell 的控制台缓冲区。
# 这样直接用 PowerShell 的滚动条 / 鼠标滚轮就能翻，不需要背任何快捷键。
#
# 所以这里**不能**套 tmux：tmux 只把重画后的那一屏交给 hdc，宿主的滚动条
# 依然是空的，反而把已经到手的回滚能力挡住了。
#
# 想要「断开还能接回同一个会话」的人，可以显式开 tmux：
#   OHC_TMUX=1 claude
if [ "${OHC_TMUX:-0}" = "1" ] && [ -x /data/ohc/rootfs/claude/usr/local/bin/ohc-tmux ]; then
    exec /data/ohc/bin/ohc run claude -- /usr/local/bin/ohc-tmux claude "$@"
fi

exec /data/ohc/bin/ohc-claude "$@"
