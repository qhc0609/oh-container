# 默认按文本处理，仓库里一律存 LF
* text=auto eol=lf

# PowerShell 脚本检出成 CRLF（Windows 上用着舒服）
*.ps1 text eol=crlf

# shell 脚本必须 LF —— 带 CRLF 推到设备上，shebang 末尾多个 \r，
# 表现是 "/system/bin/sh^M: bad interpreter"，非常难查
*.sh  text eol=lf
bin/* text eol=lf
bin/*.ps1 text eol=crlf
device-bin/* text eol=lf
scripts/archive/*.sh text eol=lf

# 二进制/归档文件不做任何转换
*.tar.gz binary
*.png binary
*.jpg binary
