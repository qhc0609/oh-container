# ============================================================
#  claude 容器环境变量  —— 由 ohc 在进入容器前 source
#  设备上实际文件：/data/ohc/containers/claude/env（权限 600）
#  不要把真实 key 提交到任何仓库
# ============================================================

# ---- DeepSeek 的 Anthropic 兼容端点 ----
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ---- 你的 DeepSeek API Key（Bearer 认证）----
# 用 ohc-setkey 写入，或手工替换下面这行
ANTHROPIC_AUTH_TOKEN=sk-REPLACE_ME

# ---- 模型：deepseek-flash 即 DeepSeek-V4.1-Flash-1017 ----
ANTHROPIC_MODEL=deepseek-flash
ANTHROPIC_SMALL_FAST_MODEL=deepseek-flash

# ---- 关掉遥测 / 自动更新 / 非必要流量 ----
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_AUTOUPDATER=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1

# ---- Alpine(musl) 下用系统 ripgrep，内置的 glibc 版 rg 跑不起来 ----
USE_BUILTIN_RIPGREP=0

# ---- 手机算力弱、网络慢，放宽超时 ----
API_TIMEOUT_MS=600000

# ---- 上下文窗口：显式声明，避免 claude 对未知模型按 200k 猜测并告警 ----
CLAUDE_CODE_MAX_CONTEXT_TOKENS=200000
CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
