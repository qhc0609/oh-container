#!/system/bin/sh
# ohc-tty —— 把「宿主机控制台」的窗口尺寸同步到当前 pty
#
# 问题根结：
#   hdc 给设备 pty 的尺寸是写死的（环境里 COLUMNS=80 LINES=24），
#   而且它既不读宿主机控制台、也不转发窗口变化。
#   所以容器里的 TUI（claude / opencode）永远按 80x24 排版，
#   PowerShell 窗口拖多大都只用到左上角。
#
#   注意：这里要的是 hdc 之外那个 PowerShell / cmd 窗口的尺寸，
#   不是 hdc shell 里那个假的 80x24。
#
# 谁来提供尺寸：
#   PC 侧 bin/ohc-term.ps1 读 [Console]::WindowWidth/WindowHeight，
#   写进 /data/ohc/run/tty（内容是「行 列」）。
#   本脚本读出来，用 busybox stty 应用到当前 pty；
#   再起一个后台守护，文件一变就跟着改（stty 触发 SIGWINCH，TUI 自己重画）。
#
# 为什么不再用 busybox resize 兜底：
#   实测这台设备上 busybox resize 既不输出结果、也不发 CSI 18 t 询问终端
#   （用真实 pty 抓过字节流，0 次询问）。留着只会让启动白等 2 秒，已删。
#   所以尺寸只有两个来源：文件（首选），或保持 pty 原值。

TTYF=${OHC_TTYFILE:-/data/ohc/run/tty}
MAXAGE=${OHC_TTY_MAXAGE:-300}
LOG=/data/ohc/logs/tty.log

TTYPATH=$(busybox tty 2>/dev/null)
case "$TTYPATH" in
    /dev/*) ;;
    *)      TTYPATH="" ;;
esac

_apply() {
    _r=$1
    _c=$2
    case "$_r" in ''|*[!0-9]*) return 1 ;; esac
    case "$_c" in ''|*[!0-9]*) return 1 ;; esac
    [ "$_r" -ge 5 ] && [ "$_c" -ge 20 ] || return 1
    if [ -n "$TTYPATH" ]; then
        busybox stty -F "$TTYPATH" rows "$_r" cols "$_c" 2>/dev/null && return 0
    fi
    busybox stty rows "$_r" cols "$_c" 2>/dev/null
}

# 文件是否「刚被宿主机写过」。过期只用来记一条日志，
# 不影响取值：旧尺寸也比死守 80x24 强。
_age() {
    [ -f "$TTYF" ] || { echo -1; return; }
    _now=$(busybox date +%s 2>/dev/null)
    case "$_now" in ''|*[!0-9]*) echo -1; return ;; esac
    _mt=$(busybox stat -c %Y "$TTYF" 2>/dev/null)
    case "$_mt" in ''|*[!0-9]*) echo -1; return ;; esac
    echo $((_now - _mt))
}

if [ -f "$TTYF" ]; then
    set -- $(cat "$TTYF" 2>/dev/null)
    if [ -n "${1:-}" ] && [ -n "${2:-}" ]; then
        if _apply "$1" "$2"; then
            _a=$(_age)
            if [ "$_a" -gt "$MAXAGE" ] 2>/dev/null; then
                mkdir -p "$(dirname "$LOG")" 2>/dev/null
                echo "$(date '+%F %T') stale size file: ${1}x${2}, age=${_a}s" >> "$LOG" 2>/dev/null
            fi
        fi
    fi
fi

# 后台跟随窗口变化；pty 设备消失就退出
if [ -n "$TTYPATH" ] && [ -f "$TTYF" ]; then
    (
        trap '' HUP
        _last=""
        while [ -c "$TTYPATH" ]; do
            _s=$(cat "$TTYF" 2>/dev/null)
            if [ -n "$_s" ] && [ "$_s" != "$_last" ]; then
                _last="$_s"
                set -- $_s
                case "${1:-}" in ''|*[!0-9]*) continue ;; esac
                case "${2:-}" in ''|*[!0-9]*) continue ;; esac
                busybox stty -F "$TTYPATH" rows "$1" cols "$2" 2>/dev/null
            fi
            sleep 1
        done
    ) >/dev/null 2>&1 &
fi
